<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mirror the library's own TFMs so net8.0 is EXECUTED, not merely compiled: the library
         multi-targets net8.0;net10.0, and a test project pinned to net10.0 alone can only ever
         catch a net8.0 regression at compile time. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-All</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unused usings) only runs on build when XML doc generation is on; CS1591
         (missing doc comments) is already silenced repo-wide in .editorconfig. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReScene\ReScene.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Exclude below is the PRIMARY guard: no .cs under TestData/ is ever copied to ANY
         output root, at the source, regardless of BaseOutputPath — so a FUTURE TestData/**/*.cs
         (there is none today) can't reintroduce this hole. tools/build-tree.cs is a standalone
         .NET file-based app (its own `#:package` directive), never part of this project's own
         compilation and never needed at test run time — see TestData/multiset/README.md's "Why
         build-tree.cs lives outside TestData/". It lives in tools/, a SIBLING of TestData/ with no
         None/Content glob of its own, specifically so it is never copied to ANY output directory —
         a prior version lived under TestData/ and got copied to bin/ by the None glob below
         (before this Exclude was added), and a forced rebuild that redirects BaseOutputPath (the
         gate's `-p:BaseOutputPath=bin2/`) shifts the SDK's default compile-exclude away from the
         conventional bin/, so a stale bin/ copy got swept into Compile and failed with CS9298
         ('#:' directives are file-based-app only). The Compile Removes below are now redundant
         defense-in-depth (kept anyway, cheaply) against any OTHER stray .cs landing under a build
         output root (bin/, obj/, or the gate's bin2*) for the same reason; bin2* uses a trailing
         wildcard so it also covers any bin2-prefixed variant, not just literal bin2/. -->
    <None Include="TestData\**\*" Exclude="TestData\**\*.cs" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="TestData\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="bin\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="bin2*\**\*.cs" />
  </ItemGroup>

</Project>
